# Optional: set this to a paired controller's Bluetooth MAC address when it is
# not discovered automatically by name. Leave blank to use discovery only.
CONTROLLER_MAC=

# Optional USB IDs for the Bluetooth adapter and GameSir controllers. Leave a
# pair blank to skip that USB wake scan.
BT_USB_VENDOR=
BT_USB_PRODUCT=
GAMESIR_USB_VENDOR=
BTCTL_TIMEOUT_SECONDS=6
